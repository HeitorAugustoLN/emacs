;;; heitor-scrolling.el --- Scrolling preferences -*- lexical-binding: t; -*-

;;; Code:

(setopt auto-window-vscroll nil
        fast-but-imprecise-scrolling t
        hscroll-margin 2
        hscroll-step 1
        scroll-conservatively 11
        scroll-error-top-bottom t
        scroll-preserve-screen-position t)

(provide 'heitor-scrolling)

